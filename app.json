{
  "expo": {
    "name": "RepairHub",
    "slug": "repairhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.repairhub.clean",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "maps",
          "tel",
          "comgooglemaps",
          "maps",
          "tel"
        ],
        "UIUserInterfaceStyle": "Light"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ng.repairhub.clean",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "RepairHub needs your photos so technicians can see what needs repairing.",
          "cameraPermission": "RepairHub uses the camera to photograph the item that needs repairing."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3563E9"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RepairHub uses your location to show how far technicians are and to match nearby repair requests."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3563E9",
          "image": "./assets/splash.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RepairHub uses the camera for your identity selfie and to photograph repairs.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RepairHub uses Face ID so you can log in without typing your password."
        }
      ]
    ],
    "scheme": "repairhubclean",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "148dc33f-345e-44cb-be21-87f97baf421b"
      }
    },
    "owner": "queennkay",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/148dc33f-345e-44cb-be21-87f97baf421b"
    }
  }
}
