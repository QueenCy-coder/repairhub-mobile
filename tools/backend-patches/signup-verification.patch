+const CODE_MINUTES = 10, MAX_ATTEMPTS = 5;
+const hashCode = (code) => crypto.createHash('sha256').update(String(code)).digest('hex');
+const maskPhone = (p = '') => (p.length > 4 ? `${'•'.repeat(p.length - 4)}${p.slice(-4)}` : p);
+const maskEmail = (e = '') => e.replace(/^(.).*(@.*)$/, '$1•••$2');
+
+// POST /api/users/verify/send   { email, channel: 'email' | 'phone' }
+// There is no email/SMS provider yet, so the code is returned in the response (set VERIFICATION_RETURN_CODE=false
+// once a provider is wired in at the marked line). Unknown emails get the same reply, minus the code.
+export const sendVerificationCode = asyncHandler(async (req, res) => {
+  const { email, channel } = req.body;
+  const user = await User.findOne({ email });
+  if (!user) return ok(res, { sent: true, channel }, 'If the account exists, a code was sent');
+  if (user.verified !== false) return ok(res, { sent: false, verified: true, channel }, 'Account already verified');
+
+  const code = String(crypto.randomInt(0, 1000000)).padStart(6, '0');
+  user.verification = { codeHash: hashCode(code), expiresAt: new Date(Date.now() + CODE_MINUTES * 60000), attempts: 0 };
+  await user.save();
+  // TODO: deliver `code` by email (SMTP) or SMS here.
+  const destination = channel === 'phone' ? maskPhone(user.phone) : maskEmail(user.email);
+  const exposeCode = process.env.VERIFICATION_RETURN_CODE !== 'false';
+  return ok(res, { sent: true, channel, destination, expiresInMinutes: CODE_MINUTES, ...(exposeCode ? { code } : {}) }, 'Verification code sent');
+});
+
+// POST /api/users/verify/confirm   { email, code }
+export const confirmVerification = asyncHandler(async (req, res) => {
+  const { email, code } = req.body;
+  const user = await User.findOne({ email }).select('+verification');
+  const v = user?.verification;
+  if (!user || !v?.codeHash) throw badRequest('Invalid or expired code');
+  if (user.verified !== false) return ok(res, { verified: true }, 'Account already verified');
+  if (v.attempts >= MAX_ATTEMPTS || v.expiresAt < new Date()) throw badRequest('Code expired. Request a new one.');
+  if (v.codeHash !== hashCode(code)) {
+    user.verification.attempts += 1;
+    await user.save();
+    throw badRequest('Invalid or expired code');
+  }
+  user.verified = true;
+  user.verification = undefined;
+  await user.save();
+  return ok(res, { verified: true }, 'Account verified');
+});
+
